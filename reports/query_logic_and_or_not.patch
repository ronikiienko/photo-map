+/// The search in words: the "all" terms joined by "and", then the "any" ones as "(a or b)", then "but not (c or d)".
+fn describe(names: &[String], groups: &[Group]) -> String {
+    let pick = |want: Group| names.iter().zip(groups).filter(|&(_, &g)| g == want).map(|(n, _)| n.as_str()).collect::<Vec<_>>();
+    let (all, some, not) = (pick(Group::All), pick(Group::Any), pick(Group::Not));
+    let mut text = match (all.is_empty(), some.len()) {
+        (_, 0) => all.join(" and "),
+        (true, _) => some.join(" or "),
+        (false, 1) => format!("{} and {}", all.join(" and "), some[0]),
+        (false, _) => format!("{} and ({})", all.join(" and "), some.join(" or ")),
+    };
+    if !not.is_empty() {
+        text += &format!(" but not {}", if not.len() == 1 { not[0].to_string() } else { format!("({})", not.join(" or ")) });
+    }
+    text
+}
+
